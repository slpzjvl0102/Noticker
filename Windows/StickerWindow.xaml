<Window x:Class="Noticker.Windows.StickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        MinWidth="166" MinHeight="172"
        SizeToContent="Manual">

    <Window.Resources>
        <!-- 16x16 resize grip in bottom-right corner -->
        <ControlTemplate x:Key="ResizeHandleTemplate" TargetType="Thumb">
            <Canvas Width="16" Height="16">
                <Line X1="4" Y1="16" X2="16" Y2="4" Stroke="#888" StrokeThickness="1.5"/>
                <Line X1="8" Y1="16" X2="16" Y2="8" Stroke="#888" StrokeThickness="1.5"/>
                <Line X1="12" Y1="16" X2="16" Y2="12" Stroke="#888" StrokeThickness="1.5"/>
            </Canvas>
        </ControlTemplate>

        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#28808080"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#50808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="{Binding TitleForeground}"/>
            <Setter Property="Foreground" Value="{Binding TitleForeground}"/>
        </Style>

        <!-- Minimal ComboBox — removes Windows chrome from the dark bar -->
        <Style x:Key="StickerComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          Cursor="Hand"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="Transparent"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#18808080"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#10808080"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Margin="{TemplateBinding Padding}"/>

                            <Path x:Name="Arrow"
                                  Fill="{TemplateBinding Foreground}"
                                  Opacity="0.55"
                                  Width="7" Height="4"
                                  Stretch="Fill"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,5,0"
                                  Data="M 0 0 L 7 0 L 3.5 4 Z"
                                  IsHitTestVisible="False"/>

                            <Popup x:Name="Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   Placement="Bottom">
                                <Border MinWidth="{Binding ActualWidth,
                                            RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        MaxHeight="200"
                                        Background="#2B2B2B"
                                        BorderThickness="1"
                                        BorderBrush="#50808080">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="8"
                                                          Opacity="0.35" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem for the dark dropdown panel -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToggleButton style for Bold / Underline -->
        <Style x:Key="FormatToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{Binding TitleForeground}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3"
                                Padding="3,1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#28808080"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#50808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer border provides shadow clearance; DropShadowEffect renders into the 10px margin -->
    <Border Margin="10">

        <!-- Inner content border — CornerRadius and shadow on same element so the shadow follows the rounded shape -->
        <Border BorderThickness="1" BorderBrush="#30808080" CornerRadius="8"
                Background="{Binding BodyBackground}">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.45"
                                  ShadowDepth="4" Direction="270"/>
            </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Top bar: drag handle, sync dot, title, X button -->
            <Border Grid.Row="0" Background="{Binding TitleBackground}"
                    CornerRadius="8 8 0 0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>

                <!-- Sync indicator -->
                <Ellipse x:Name="SyncDot" Grid.Column="0"
                         Width="8" Height="8"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Fill="{Binding SyncDotColor}">
                    <Ellipse.ToolTip>
                        <ToolTip Content="{Binding SyncTooltip}"/>
                    </Ellipse.ToolTip>
                </Ellipse>

                <!-- Title input with placeholder -->
                <Grid Grid.Column="1">
                    <TextBox x:Name="TitleBox"
                             Style="{StaticResource TitleBoxStyle}"
                             Text="{Binding StickerTitle, UpdateSourceTrigger=PropertyChanged}"
                             TabIndex="0"
                             MouseLeftButtonDown="TitleBox_MouseLeftButtonDown"
                             TextChanged="TitleBox_TextChanged"/>
                    <TextBlock Text="제목"
                               Foreground="{Binding TitleForeground}"
                               Opacity="0.35"
                               Padding="4,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=TitleBox, Path=Text.Length}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Menu button (···) -->
                <Button x:Name="MenuButton" Grid.Column="2"
                        Style="{StaticResource DeleteButtonStyle}"
                        Foreground="{Binding TitleForeground}"
                        VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                        TabIndex="3"
                        Click="MenuButton_Click">
                    <TextBlock Text="···" FontSize="12"
                               Foreground="{Binding TitleForeground}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="노트 목록" Click="MenuItem_NoteList_Click"/>
                            <Separator/>
                            <MenuItem Header="메모 삭제" Click="MenuItem_Delete_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- Close (hide) button -->
                <Button Grid.Column="3" Content="×"
                        Style="{StaticResource DeleteButtonStyle}"
                        Foreground="{Binding TitleForeground}"
                        FontSize="16"
                        VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                        TabIndex="4"
                        Click="CloseButton_Click"/>
            </Grid>
            </Border>

            <!-- Row 1: Body text area with placeholder -->
            <Grid Grid.Row="1">
                <RichTextBox x:Name="BodyBox"
                             Background="{Binding BodyBackground}"
                             Foreground="{Binding BodyForeground}"
                             BorderThickness="0"
                             Padding="6,4"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             FontSize="13"
                             TabIndex="1"
                             PreviewKeyDown="BodyBox_PreviewKeyDown"
                             TextChanged="BodyBox_TextChanged"
                             SelectionChanged="BodyBox_SelectionChanged"/>
                <TextBlock x:Name="BodyPlaceholder"
                           Text="메모..."
                           Foreground="{Binding BodyForeground}"
                           Opacity="0.35"
                           Padding="12,8"
                           VerticalAlignment="Top"
                           FontSize="13"
                           IsHitTestVisible="False"
                           Visibility="Visible"/>
            </Grid>

            <!-- Row 2: Formatting bar (visible only when window is active) -->
            <Grid Grid.Row="2" Background="{Binding TitleBackground}"
                  Visibility="{Binding IsFormattingBarVisible,
                      Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">

                    <!-- Font family dropdown -->
                    <ComboBox x:Name="FontFamilyBox"
                              ItemsSource="{Binding AvailableFonts}"
                              SelectedValue="{Binding StickerFontFamily}"
                              Foreground="{Binding TitleForeground}"
                              Width="120" Margin="0,0,4,0"
                              FontSize="12"
                              Style="{StaticResource StickerComboBoxStyle}"
                              Padding="4,0" TabIndex="4"
                              SelectionChanged="FontFamilyBox_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontFamily="{Binding}" FontSize="12"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- Bold -->
                    <ToggleButton x:Name="BoldButton"
                                  Style="{StaticResource FormatToggleStyle}"
                                  Width="22" Height="22" Margin="2,0"
                                  ToolTip="굵게 (Ctrl+B)"
                                  Click="BoldButton_Click">
                        <TextBlock Text="B" FontWeight="Bold" FontSize="12"
                                   Foreground="{Binding TitleForeground}"/>
                    </ToggleButton>

                    <!-- Underline -->
                    <ToggleButton x:Name="UnderlineButton"
                                  Style="{StaticResource FormatToggleStyle}"
                                  Width="22" Height="22" Margin="2,0"
                                  ToolTip="밑줄 (Ctrl+U)"
                                  Click="UnderlineButton_Click">
                        <TextBlock Text="U" TextDecorations="Underline" FontSize="12"
                                   Foreground="{Binding TitleForeground}"/>
                    </ToggleButton>

                    <!-- Bullet list -->
                    <ToggleButton x:Name="BulletButton"
                                  Style="{StaticResource FormatToggleStyle}"
                                  Width="22" Height="22" Margin="2,0"
                                  ToolTip="불릿 리스트 (- + Space)"
                                  Click="BulletButton_Click">
                        <TextBlock Text="•" FontSize="14"
                                   Foreground="{Binding TitleForeground}"/>
                    </ToggleButton>

                    <!-- Numbered list -->
                    <ToggleButton x:Name="NumberButton"
                                  Style="{StaticResource FormatToggleStyle}"
                                  Width="22" Height="22" Margin="2,0"
                                  ToolTip="번호 리스트 (1. + Space)"
                                  Click="NumberButton_Click">
                        <TextBlock Text="1." FontSize="11"
                                   Foreground="{Binding TitleForeground}"/>
                    </ToggleButton>
                </StackPanel>
            </Grid>

            <!-- Row 3: Bottom bar: category dropdown + char counter + resize handle -->
            <Border Grid.Row="3" Background="{Binding TitleBackground}"
                    CornerRadius="0 0 8 8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>

                <!-- Category dropdown -->
                <ComboBox x:Name="CategoryBox" Grid.Column="0"
                          SelectedValue="{Binding Category}"
                          ItemsSource="{Binding CategoryOptions}"
                          Foreground="{Binding TitleForeground}"
                          FontSize="12" VerticalAlignment="Center"
                          Padding="4,0" TabIndex="2"
                          SelectionChanged="CategoryBox_SelectionChanged"
                          IsEnabled="{Binding HasCategoryOptions}"
                          ToolTipService.ShowOnDisabled="True">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource StickerComboBoxStyle}">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="ToolTip" Value="설정에서 카테고리 옵션을 새로고침하세요"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>

                <!-- Char counter (visible only when >= 1800 chars) -->
                <TextBlock x:Name="CharCounter" Grid.Column="1"
                           Text="{Binding CharCounterText}"
                           Visibility="{Binding CharCounterVisibility}"
                           Foreground="#EF4444" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>

                <!-- Resize handle (bottom-right) -->
                <Thumb Grid.Column="2" Width="16" Height="20"
                       Cursor="SizeNWSE" VerticalAlignment="Bottom"
                       DragDelta="ResizeThumb_DragDelta"
                       Background="Transparent"
                       Template="{StaticResource ResizeHandleTemplate}"/>
            </Grid>
            </Border>
        </Grid>
        </Border>
    </Border>
</Window>
