<Window x:Class="Noticker.Windows.StickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        MinWidth="166" MinHeight="136"
        SizeToContent="Manual">

    <Window.Resources>
        <!-- 16x16 resize grip in bottom-right corner -->
        <ControlTemplate x:Key="ResizeHandleTemplate" TargetType="Thumb">
            <Canvas Width="16" Height="16">
                <Line X1="4" Y1="16" X2="16" Y2="4" Stroke="#888" StrokeThickness="1.5"/>
                <Line X1="8" Y1="16" X2="16" Y2="8" Stroke="#888" StrokeThickness="1.5"/>
                <Line X1="12" Y1="16" X2="16" Y2="12" Stroke="#888" StrokeThickness="1.5"/>
            </Canvas>
        </ControlTemplate>

        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#28808080"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#50808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="{Binding TitleForeground}"/>
            <Setter Property="Foreground" Value="{Binding TitleForeground}"/>
        </Style>
        <Style x:Key="BodyBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="AcceptsTab" Value="False"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="{Binding BodyForeground}"/>
            <Setter Property="Foreground" Value="{Binding BodyForeground}"/>
        </Style>

        <!-- Minimal ComboBox — removes Windows chrome from the dark bar -->
        <Style x:Key="StickerComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          BorderThickness="0"
                                          Background="Transparent"
                                          Cursor="Hand"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="Transparent"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#18808080"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#10808080"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Margin="{TemplateBinding Padding}"/>

                            <Path x:Name="Arrow"
                                  Fill="{TemplateBinding Foreground}"
                                  Opacity="0.55"
                                  Width="7" Height="4"
                                  Stretch="Fill"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,5,0"
                                  Data="M 0 0 L 7 0 L 3.5 4 Z"
                                  IsHitTestVisible="False"/>

                            <Popup x:Name="Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   Placement="Bottom">
                                <Border MinWidth="{Binding ActualWidth,
                                            RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        MaxHeight="200"
                                        Background="#2B2B2B"
                                        BorderThickness="1"
                                        BorderBrush="#50808080">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" BlurRadius="8"
                                                          Opacity="0.35" ShadowDepth="2"/>
                                    </Border.Effect>
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem for the dark dropdown panel -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#25FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer border provides shadow clearance; DropShadowEffect renders into the 10px margin -->
    <Border Margin="10" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.45"
                              ShadowDepth="4" Direction="270"/>
        </Border.Effect>

        <!-- Inner content border — 1px frame visible on any background -->
        <Border BorderThickness="1" BorderBrush="#30808080" CornerRadius="8">
        <Grid Background="{Binding BodyBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <!-- Top bar: drag handle, sync dot, title, X button -->
            <Grid Grid.Row="0" Background="{Binding TitleBackground}"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="24"/>
                </Grid.ColumnDefinitions>

                <!-- Sync indicator -->
                <Ellipse x:Name="SyncDot" Grid.Column="0"
                         Width="8" Height="8"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Fill="{Binding SyncDotColor}">
                    <Ellipse.ToolTip>
                        <ToolTip Content="{Binding SyncTooltip}"/>
                    </Ellipse.ToolTip>
                </Ellipse>

                <!-- Title input with placeholder -->
                <Grid Grid.Column="1">
                    <TextBox x:Name="TitleBox"
                             Style="{StaticResource TitleBoxStyle}"
                             Text="{Binding StickerTitle, UpdateSourceTrigger=PropertyChanged}"
                             TabIndex="0"
                             MouseLeftButtonDown="TitleBox_MouseLeftButtonDown"
                             TextChanged="TitleBox_TextChanged"/>
                    <TextBlock Text="제목"
                               Foreground="{Binding TitleForeground}"
                               Opacity="0.35"
                               Padding="4,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=TitleBox, Path=Text.Length}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Delete button -->
                <Button Grid.Column="2" Content="×"
                        Style="{StaticResource DeleteButtonStyle}"
                        Foreground="{Binding TitleForeground}"
                        FontSize="16"
                        VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                        TabIndex="3"
                        Click="DeleteButton_Click"/>
            </Grid>

            <!-- Body text area with placeholder -->
            <Grid Grid.Row="1">
                <TextBox x:Name="BodyBox"
                         Style="{StaticResource BodyBoxStyle}"
                         Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                         Background="{Binding BodyBackground}"
                         TabIndex="1"
                         TextChanged="BodyBox_TextChanged"/>
                <TextBlock Text="메모..."
                           Foreground="{Binding BodyForeground}"
                           Opacity="0.35"
                           Padding="6,4"
                           VerticalAlignment="Top"
                           FontSize="13"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=BodyBox, Path=Text.Length}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Bottom bar: category dropdown + char counter -->
            <Grid Grid.Row="2" Background="{Binding TitleBackground}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="20"/>
                </Grid.ColumnDefinitions>

                <!-- Category dropdown -->
                <ComboBox x:Name="CategoryBox" Grid.Column="0"
                          SelectedValue="{Binding Category}"
                          ItemsSource="{Binding CategoryOptions}"
                          Foreground="{Binding TitleForeground}"
                          FontSize="12" VerticalAlignment="Center"
                          Padding="4,0" TabIndex="2"
                          SelectionChanged="CategoryBox_SelectionChanged"
                          IsEnabled="{Binding HasCategoryOptions}">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource StickerComboBoxStyle}">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="ToolTip" Value="설정에서 카테고리 옵션을 새로고침하세요"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>

                <!-- Char counter (visible only when >= 1800 chars) -->
                <TextBlock x:Name="CharCounter" Grid.Column="1"
                           Text="{Binding CharCounterText}"
                           Visibility="{Binding CharCounterVisibility}"
                           Foreground="#EF4444" FontSize="10"
                           VerticalAlignment="Center" Margin="0,0,4,0"/>

                <!-- Resize handle (bottom-right) -->
                <Thumb Grid.Column="2" Width="16" Height="20"
                       Cursor="SizeNWSE" VerticalAlignment="Bottom"
                       DragDelta="ResizeThumb_DragDelta"
                       Background="Transparent"
                       Template="{StaticResource ResizeHandleTemplate}"/>
            </Grid>
        </Grid>
        </Border>
    </Border>
</Window>
