<Window x:Class="Noticker.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Noticker 설정"
        Width="420" Height="520"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource SurfaceBrush}">

    <Window.Resources>
        <!-- 버튼/라벨은 Styles/SharedStyles.xaml 공유 — 창 전용 리소스만 여기 둔다 -->

        <!-- Section heading -->
        <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSectionBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>

        <!-- Line-style TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="0,6"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderInputBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        </Style>

        <!-- Line-style PasswordBox — 공유 LinePasswordBoxStyle + 창 고유 Margin -->
        <Style TargetType="PasswordBox" BasedOn="{StaticResource LinePasswordBoxStyle}">
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <!-- Minimal CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource InkHoverBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Black header — mirrors the sticker title bar -->
        <Grid Grid.Row="0" Background="{StaticResource InkBrush}">
            <TextBlock Text="Noticker 설정"
                       Foreground="White"
                       FontSize="14"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="20,0"/>
        </Grid>

        <!-- Content area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20,16,20,20">

                <!-- 노션 연결 — 입력은 OnboardingWindow가 소유, 여기는 요약만 -->
                <TextBlock Text="노션 연결" Style="{StaticResource SectionHeadingStyle}"
                           Margin="0,0,0,8"/>
                <TextBlock x:Name="ConnectionSummary" FontSize="13" Foreground="{StaticResource InkBrush}"
                           TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button x:Name="ReconnectButton" Content="연결 다시 설정"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="0,0,8,0"
                            Click="ReconnectButton_Click"/>
                </StackPanel>

                <Separator Background="#EEEEEE" Margin="0,4,0,0"/>

                <!-- Category refresh -->
                <TextBlock Text="카테고리 옵션" Style="{StaticResource SectionHeadingStyle}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button x:Name="RefreshCatButton" Content="옵션 새로고침"
                            Style="{StaticResource ActionButtonStyle}"
                            Margin="0,0,8,0"
                            Click="RefreshCatButton_Click"/>
                </StackPanel>
                <TextBlock x:Name="CatStatusText" FontSize="12" Foreground="#555555"
                           Margin="0,0,0,12"/>

                <Separator Background="#EEEEEE" Margin="0,4,0,0"/>

                <!-- Options -->
                <TextBlock Text="옵션" Style="{StaticResource SectionHeadingStyle}"/>

                <CheckBox x:Name="ColorSwapCheck" Content="색상 Swap (흑↔백)"/>
                <CheckBox x:Name="AutostartCheck" Content="Windows 시작 시 자동 실행"/>

                <TextBlock Text="새 스티커 단축키 (전역)" Style="{StaticResource FieldLabelStyle}"
                           Margin="0,8,0,4"/>
                <ComboBox x:Name="HotkeyCombo" Width="180" HorizontalAlignment="Left"
                          FontSize="13" Margin="0,0,0,4">
                    <ComboBoxItem Content="Ctrl+Alt+N" Tag="ctrl_alt_n"/>
                    <ComboBoxItem Content="Win+Shift+N" Tag="win_shift_n"/>
                    <ComboBoxItem Content="Ctrl+Alt+Space" Tag="ctrl_alt_space"/>
                    <ComboBoxItem Content="사용 안 함" Tag="none"/>
                </ComboBox>
                <TextBlock x:Name="HotkeyStatusText" FontSize="12" Foreground="{StaticResource DangerBrush}"
                           Margin="0,0,0,8" Visibility="Collapsed"/>

                <!-- Pomodoro -->
                <TextBlock Text="포모도로" Style="{StaticResource SectionHeadingStyle}"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="집중 시간 (분, 1-120)"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="짧은 휴식 (분, 1-60)"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="1" Grid.Column="0" x:Name="PomFocusBox"/>
                    <TextBox Grid.Row="1" Grid.Column="2" x:Name="PomShortBox"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="긴 휴식 (분, 1-60)"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="긴 휴식 간격 (세션, 1-12)"
                               Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Grid.Row="3" Grid.Column="0" x:Name="PomLongBox"/>
                    <TextBox Grid.Row="3" Grid.Column="2" x:Name="PomIntervalBox"/>
                </Grid>

                <CheckBox x:Name="PomAutoStartCheck" Content="다음 세션 자동 시작"/>
                <CheckBox x:Name="PomSoundCheck" Content="세션 종료 사운드"/>

                <Separator Background="#EEEEEE" Margin="0,8,0,16"/>

                <!-- Save button -->
                <Button x:Name="SaveButton" Content="저장"
                        HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButtonStyle}"
                        IsDefault="True"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
