<Window x:Class="Noticker.Windows.PomodoroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        Width="200" Height="170"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- 22x22 control button — FormatToggleStyle과 동일한 hover/pressed + disabled 0.35 -->
        <Style x:Key="PomodoroButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#28808080"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#50808080"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 핀 토글 — checked = #50808080 (FormatToggleStyle 재사용 어법) -->
        <Style x:Key="PomodoroToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#28808080"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#50808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 그림자 여백 10px — 스티커 창과 동일한 이중 Border 구조 -->
    <Border Margin="10">
        <Border BorderThickness="1" BorderBrush="#30808080" CornerRadius="8"
                Background="{Binding BodyBackground}">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.45"
                                  ShadowDepth="4" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <!-- Row 0: 타이틀 바 — 드래그 + 핀 + 숨기기 -->
                <Border Grid.Row="0" Background="{Binding TitleBackground}"
                        CornerRadius="8 8 0 0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="24"/>
                        </Grid.ColumnDefinitions>

                        <ToggleButton x:Name="PinButton" Grid.Column="1"
                                      Style="{StaticResource PomodoroToggleStyle}"
                                      ToolTip="항상 위에 고정"
                                      AutomationProperties.Name="항상 위에 고정"
                                      Checked="PinButton_Toggled" Unchecked="PinButton_Toggled">
                            <Path Width="16" Height="16"
                                  Data="M5,0 L11,0 L11,2 L10,2 L10,6 L13,9 L13,10 L8.7,10 L8,15 L7.3,10 L3,10 L3,9 L6,6 L6,2 L5,2 Z"
                                  Fill="{Binding TitleForeground}"/>
                        </ToggleButton>

                        <Button Grid.Column="2"
                                Style="{StaticResource PomodoroButtonStyle}"
                                ToolTip="숨기기"
                                AutomationProperties.Name="숨기기"
                                Click="HideButton_Click">
                            <TextBlock Text="×" FontSize="16"
                                       Foreground="{Binding TitleForeground}"
                                       Margin="0,-2,0,0"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Row 1: 모드 라벨 / 시간 / 세션 도트 -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ModeText}"
                               FontSize="11" Opacity="0.55"
                               Foreground="{Binding BodyForeground}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding TimeText}"
                               FontSize="36" FontWeight="Light"
                               Typography.NumeralAlignment="Tabular"
                               Foreground="{Binding BodyForeground}"
                               Opacity="{Binding TimeOpacity}"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0"
                               AutomationProperties.Name="{Binding TimeAutomationName}"/>
                    <StackPanel x:Name="DotsPanel" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Row 2: 컨트롤 바 — 리셋 | 시작·일시정지 | 건너뛰기 -->
                <Border Grid.Row="2" Background="{Binding TitleBackground}"
                        CornerRadius="0 0 8 8">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="ResetButton"
                                Style="{StaticResource PomodoroButtonStyle}"
                                ToolTip="리셋"
                                AutomationProperties.Name="리셋"
                                IsEnabled="{Binding ResetEnabled}"
                                Click="Reset_Click" Margin="0,0,4,0">
                            <TextBlock Text="↺" FontSize="14"
                                       Foreground="{Binding TitleForeground}"/>
                        </Button>

                        <Button x:Name="StartPauseButton"
                                Style="{StaticResource PomodoroButtonStyle}"
                                ToolTip="{Binding StartPauseTooltip}"
                                AutomationProperties.Name="{Binding StartPauseTooltip}"
                                Click="StartPause_Click" Margin="4,0">
                            <Grid>
                                <Path Data="M 0 0 L 9 5.5 L 0 11 Z"
                                      Width="9" Height="11"
                                      Fill="{Binding TitleForeground}"
                                      Visibility="{Binding PlayGlyphVisibility}"/>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding PauseGlyphVisibility}">
                                    <Rectangle Width="3" Height="11" Fill="{Binding TitleForeground}"/>
                                    <Rectangle Width="3" Height="11" Fill="{Binding TitleForeground}" Margin="3,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <Button x:Name="SkipButton"
                                Style="{StaticResource PomodoroButtonStyle}"
                                ToolTip="건너뛰기"
                                AutomationProperties.Name="건너뛰기"
                                Click="Skip_Click" Margin="4,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 0 0 L 7 5 L 0 10 Z"
                                      Width="7" Height="10"
                                      Fill="{Binding TitleForeground}"/>
                                <Rectangle Width="1.5" Height="10"
                                           Fill="{Binding TitleForeground}" Margin="1,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
