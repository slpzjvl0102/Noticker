<Window x:Class="Noticker.Windows.PomodoroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Noticker.Windows.Controls"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        AllowsTransparency="True"
        Background="Transparent"
        Width="220" Height="240"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- 22x22 control button — FormatToggleStyle과 동일한 hover/pressed + disabled 0.35 -->
        <Style x:Key="PomodoroButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#28808080"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#50808080"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 토글 (핀·kind) — checked = #50808080 -->
        <Style x:Key="PomodoroToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#28808080"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#50808080"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 그림자 여백 10px — 스티커 창과 동일한 이중 Border 구조 -->
    <Border Margin="10">
        <Border BorderThickness="1" BorderBrush="#30808080" CornerRadius="8"
                Background="{Binding BodyBackground}">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="20" Opacity="0.45"
                                  ShadowDepth="4" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="28"/>
                    <RowDefinition Height="164"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <!-- Row 0: 타이틀 바 — kind 토글 + 드래그 + 핀 + 숨기기 -->
                <Border Grid.Row="0" Background="{Binding TitleBackground}"
                        CornerRadius="8 8 0 0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="24"/>
                        </Grid.ColumnDefinitions>

                        <!-- kind 토글: checked = 커스텀(모래시계), Idle에서만 활성 -->
                        <ToggleButton x:Name="KindToggle" Grid.Column="0"
                                      Style="{StaticResource PomodoroToggleStyle}"
                                      ToolTip="타이머 모드 전환"
                                      AutomationProperties.Name="타이머 모드 전환"
                                      Click="KindToggle_Click">
                            <Path Width="16" Height="16"
                                  Data="M4,2 L12,2 L12,4 L9,8 L12,12 L12,14 L4,14 L4,12 L7,8 L4,4 Z"
                                  Fill="{Binding TitleForeground}"/>
                        </ToggleButton>

                        <ToggleButton x:Name="PinButton" Grid.Column="2"
                                      Style="{StaticResource PomodoroToggleStyle}"
                                      ToolTip="항상 위에 고정"
                                      AutomationProperties.Name="항상 위에 고정"
                                      Checked="PinButton_Toggled" Unchecked="PinButton_Toggled">
                            <Path Width="16" Height="16"
                                  Data="M5,0 L11,0 L11,2 L10,2 L10,6 L13,9 L13,10 L8.7,10 L8,15 L7.3,10 L3,10 L3,9 L6,6 L6,2 L5,2 Z"
                                  Fill="{Binding TitleForeground}"/>
                        </ToggleButton>

                        <Button Grid.Column="3"
                                Style="{StaticResource PomodoroButtonStyle}"
                                ToolTip="숨기기"
                                AutomationProperties.Name="숨기기"
                                Click="HideButton_Click">
                            <TextBlock Text="×" FontSize="16"
                                       Foreground="{Binding TitleForeground}"
                                       Margin="0,-2,0,0"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Row 1 (164px): 4 + 다이얼 144 + 4 + 보조 행 12 -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="144"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="12"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="1" Width="144" Height="144" HorizontalAlignment="Center">
                        <controls:TimerDial x:Name="Dial"
                                            Fraction="{Binding DialFraction}"
                                            WedgeBrush="{Binding WedgeBrush}"
                                            WedgeStroke="{Binding WedgeStrokeBrush}"
                                            FaceBrush="{Binding BodyBackground}"
                                            TickBrush="{Binding BodyForeground}"
                                            IsOutlineOnly="{Binding DialOutlineOnly}"
                                            IsSettable="{Binding DialSettable}"
                                            WedgeOpacity="{Binding DialWedgeOpacity}"/>

                        <!-- 중앙 플레이트 내용 — 다이얼 위 오버레이 (히트 영역 방해 금지) -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    IsHitTestVisible="False">
                            <TextBlock Text="{Binding ModeText}"
                                       FontSize="9" Opacity="0.55"
                                       Foreground="{Binding BodyForeground}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TimeText}"
                                       FontSize="13"
                                       Typography.NumeralAlignment="Tabular"
                                       Foreground="{Binding BodyForeground}"
                                       Opacity="{Binding TimeOpacity}"
                                       HorizontalAlignment="Center"
                                       AutomationProperties.Name="{Binding TimeAutomationName}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 보조 행: 도트(포모도로 kind만, Hidden으로 자리 유지) + 오버플로 -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                        <StackPanel x:Name="DotsPanel" Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding DotsVisibility}"/>
                        <TextBlock Text="{Binding OverflowText}"
                                   FontSize="11" Opacity="0.55"
                                   Foreground="{Binding BodyForeground}"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   Visibility="{Binding OverflowVisibility}"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: 컨트롤 바 — 리셋 | 시작·일시정지 | 건너뛰기 -->
                <Border Grid.Row="2" Background="{Binding TitleBackground}"
                        CornerRadius="0 0 8 8">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="ResetButton"
                                Style="{StaticResource PomodoroButtonStyle}"
                                ToolTip="리셋"
                                AutomationProperties.Name="리셋"
                                IsEnabled="{Binding ResetEnabled}"
                                Click="Reset_Click" Margin="0,0,4,0">
                            <TextBlock Text="↺" FontSize="14"
                                       Foreground="{Binding TitleForeground}"/>
                        </Button>

                        <Button x:Name="StartPauseButton"
                                Style="{StaticResource PomodoroButtonStyle}"
                                ToolTip="{Binding StartPauseTooltip}"
                                AutomationProperties.Name="{Binding StartPauseTooltip}"
                                Click="StartPause_Click" Margin="4,0">
                            <Grid>
                                <Path Data="M 0 0 L 9 5.5 L 0 11 Z"
                                      Width="9" Height="11"
                                      Fill="{Binding TitleForeground}"
                                      Visibility="{Binding PlayGlyphVisibility}"/>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding PauseGlyphVisibility}">
                                    <Rectangle Width="3" Height="11" Fill="{Binding TitleForeground}"/>
                                    <Rectangle Width="3" Height="11" Fill="{Binding TitleForeground}" Margin="3,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- 커스텀 kind에서 Hidden (자리 유지 — 중앙 정렬 불변) -->
                        <Button x:Name="SkipButton"
                                Style="{StaticResource PomodoroButtonStyle}"
                                ToolTip="건너뛰기"
                                AutomationProperties.Name="건너뛰기"
                                Visibility="{Binding SkipVisibility}"
                                Click="Skip_Click" Margin="4,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 0 0 L 7 5 L 0 10 Z"
                                      Width="7" Height="10"
                                      Fill="{Binding TitleForeground}"/>
                                <Rectangle Width="1.5" Height="10"
                                           Fill="{Binding TitleForeground}" Margin="1,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
