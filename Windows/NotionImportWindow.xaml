<Window x:Class="Noticker.Windows.NotionImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notion에서 가져오기" Width="320" Height="460"
        MinWidth="240" MinHeight="280"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="False"
        ResizeMode="CanResize">
    <DockPanel x:Name="RootPanel">
        <!-- 안내 -->
        <Border x:Name="HeaderBorder" DockPanel.Dock="Top" Padding="12,8"
                BorderThickness="0,0,0,1">
            <TextBlock x:Name="HeaderLabel"
                       Text="스티커와 연결되지 않은 Notion 페이지입니다. 선택하면 스티커로 가져옵니다."
                       FontSize="11" TextWrapping="Wrap"/>
        </Border>

        <!-- 상태/빈 목록 메시지 -->
        <TextBlock x:Name="StatusLabel"
                   DockPanel.Dock="Bottom"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="24,8"
                   Text="불러오는 중…"/>

        <!-- 페이지 목록 -->
        <ListView x:Name="PageList"
                  SelectionChanged="PageList_SelectionChanged"
                  BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource PlainListViewItemStyle}"/>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <!-- 구분선/날짜 색은 양 테마에서 읽히는 중간값 고정 (#50808080 / #AAAAAA) -->
                    <Border x:Name="RowBorder" Padding="12,8" BorderThickness="0,0,0,1"
                            BorderBrush="#50808080">
                        <StackPanel>
                            <TextBlock x:Name="TitleLabel"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="12"/>
                            <TextBlock x:Name="DateLabel"
                                       Text="{Binding DateLabel}"
                                       Foreground="#AAAAAA"
                                       FontSize="10" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </DockPanel>
</Window>
