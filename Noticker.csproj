<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Noticker</AssemblyName>
    <RootNamespace>Noticker</RootNamespace>
    <ApplicationIcon>Assets\noticker.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 배포 버전 — release.ps1이 이 값으로 Velopack 패키지를 만든다. 배포할 때마다 올릴 것 -->
    <Version>2026.11.23</Version>
    <!-- Velopack 훅을 WPF보다 먼저 처리하기 위해 Program.Main을 진입점으로 쓴다 -->
    <StartupObject>Noticker.Program</StartupObject>
    <!-- WFAC010은 WinForms 진입점(ApplicationConfiguration.Initialize)용 권고다. 이 앱은 WPF가
         진입점이라 ApplicationHighDpiMode 속성이 적용되지 않으므로, DPI 인식은 manifest가 정답 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\noticker.ico"/>
    <Content Include="GUIDE.txt" CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Noticker.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.*" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
